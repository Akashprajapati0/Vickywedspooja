/* ==========================================================================
   InviteUtsav — shared phone-number field (country code select + digits-only
   number input, India +91 / 10 digits by default). Used on the guest RSVP
   forms and in the invitation editor. Progressively enhances a
   <div class="phone-field" data-phone-field> containing a .phone-field__code
   <select>, a .phone-field__number <input>, a plain <input type="hidden">
   that ends up holding the combined "+<code><digits>" (E.164) value under the
   real field name the form submits, and a .phone-field__error message line.

   Per-country rules (digit count + allowed first digit) are carried on each
   <option> as data-min / data-max / data-lead, generated by
   template-parts/phone-field.php from the same table the server enforces
   (inviteutsav-core inc/phone-rules.php). A country without a rule falls back
   to a generic realistic range.

   A number that was already saved (data-initial) is shown as-is and left
   untouched until the customer edits it — an older format never blocks a save.
   ========================================================================== */
(function () {
  'use strict';

  var GENERIC_MIN = 6;
  var GENERIC_MAX = 14;

  function opt(select) { return select.options[select.selectedIndex]; }
  function minLen(select) { var n = parseInt(opt(select) && opt(select).getAttribute('data-min'), 10); return n > 0 ? n : GENERIC_MIN; }
  function maxLen(select) { var n = parseInt(opt(select) && opt(select).getAttribute('data-max'), 10); return n > 0 ? n : GENERIC_MAX; }
  function countryName(select) { var o = opt(select); return o ? (o.getAttribute('data-full') || o.textContent).replace(/\s*\+\d+\s*$/, '').trim() : ''; }
  // On a phone the closed select shows just the code (+91) so the number box keeps enough room on the same line;
  // the full country list is restored the moment the select is opened (focus / tap) and collapsed again afterwards.
  function narrowScreen() { return !!(window.matchMedia && window.matchMedia('(max-width: 680px)').matches); }
  function expandCodes(select) { Array.prototype.forEach.call(select.options, function (o) { o.textContent = o.getAttribute('data-full') || o.textContent; }); }
  function collapseCodes(select) { if (!narrowScreen()) { expandCodes(select); return; } Array.prototype.forEach.call(select.options, function (o) { o.textContent = '+' + o.value; }); }

  function parts(wrapper) {
    return {
      select: wrapper.querySelector('.phone-field__code'),
      input: wrapper.querySelector('.phone-field__number'),
      hidden: wrapper.querySelector('input[type="hidden"]'),
      error: wrapper.querySelector('.phone-field__error')
    };
  }

  function syncHidden(wrapper) {
    var p = parts(wrapper);
    if (!p.select || !p.input || !p.hidden) return;
    p.hidden.value = p.input.value ? '+' + p.select.value + p.input.value : '';
  }

  // Returns '' when fine, otherwise a plain-language message.
  function problem(wrapper) {
    var p = parts(wrapper);
    if (!p.select || !p.input) return '';
    if (wrapper.dataset.pristine === '1') return '';
    var v = p.input.value;
    if (!v) return p.input.required ? 'Please enter a phone number.' : '';
    var min = minLen(p.select), max = maxLen(p.select), name = countryName(p.select);
    var lead = opt(p.select) && opt(p.select).getAttribute('data-lead');
    var lenText = min === max ? min + '-digit' : min + '–' + max + ' digit';
    if (v.length < min || v.length > max) return 'Please enter a valid ' + lenText + ' ' + name + ' number (without the country code).';
    if (lead && !new RegExp('^' + lead).test(v)) return 'That is not a valid ' + name + ' number — please check the first digit.';
    return '';
  }

  function showProblem(wrapper) {
    var p = parts(wrapper);
    var msg = problem(wrapper);
    if (p.error) { p.error.textContent = msg; p.error.hidden = !msg; }
    p.input.classList.toggle('is-invalid', !!msg);
    p.input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    return !msg;
  }

  function isValid(wrapper) { return showProblem(wrapper); }

  function touch(wrapper) { delete wrapper.dataset.pristine; }

  // Splits a stored "+<code><digits>" value back into select + number.
  function populate(wrapper, combinedValue) {
    var p = parts(wrapper);
    if (!p.select || !p.input) return;
    var value = (combinedValue || '').trim();
    var matched = false;
    if (value.charAt(0) === '+') {
      for (var i = 0; i < p.select.options.length; i++) {
        var code = p.select.options[i].value;
        if (value.slice(1, 1 + code.length) === code) {
          p.select.selectedIndex = i;
          p.input.value = value.slice(1 + code.length).replace(/\D/g, '').slice(0, 15);
          matched = true;
          break;
        }
      }
    }
    if (!matched) p.input.value = value.replace(/\D/g, '').slice(0, 15);
    p.input.setAttribute('maxlength', maxLen(p.select));
    syncHidden(wrapper);
  }

  // The country-code box takes on the look of the NUMBER box next to it (border, radius, colours, padding, font, height), measured from the
  // design's own styling and handed to assets/css/phone-field.css through --pf-* variables. So the two always match in every design, present or
  // future, with no per-design phone CSS. (Until this has run, the stylesheet's neutral defaults apply.)
  function mirrorStyle(wrapper) {
    var p = parts(wrapper);
    if (!p.select || !p.input || !window.getComputedStyle) return;
    var cs = window.getComputedStyle(p.input), set = wrapper.style.setProperty.bind(wrapper.style);
    ['Top', 'Right', 'Bottom', 'Left'].forEach(function (side) {
      var w = cs['border' + side + 'Width'], st = cs['border' + side + 'Style'], c = cs['border' + side + 'Color'];
      set('--pf-b' + side.charAt(0).toLowerCase(), (st === 'none' || st === 'hidden' || !(parseFloat(w) > 0)) ? '0 none transparent' : w + ' ' + st + ' ' + c);
    });
    set('--pf-rad', cs.borderTopLeftRadius + ' ' + cs.borderTopRightRadius + ' ' + cs.borderBottomRightRadius + ' ' + cs.borderBottomLeftRadius);
    set('--pf-bg', cs.backgroundColor);
    set('--pf-color', cs.color);
    set('--pf-ff', cs.fontFamily);
    set('--pf-fs', cs.fontSize);
    set('--pf-fw', cs.fontWeight);
    set('--pf-ls', cs.letterSpacing);
    set('--pf-pt', cs.paddingTop);
    set('--pf-pb', cs.paddingBottom);
    set('--pf-pl', cs.paddingLeft);
    var h = p.input.offsetHeight; // layout height: unlike getBoundingClientRect it is not thrown off by a design's reveal / scale animations
    if (h > 0) set('--pf-h', h + 'px');
    wrapper.setAttribute('data-pf-mirrored', '');
  }
  function mirrorAll() { document.querySelectorAll('[data-phone-field]').forEach(mirrorStyle); }
  var mirrorTimer = null;
  function mirrorSoon() { clearTimeout(mirrorTimer); mirrorTimer = setTimeout(mirrorAll, 150); }
  window.addEventListener('load', mirrorSoon);
  window.addEventListener('resize', mirrorSoon);
  window.addEventListener('orientationchange', mirrorSoon);
  if (document.fonts && document.fonts.ready) { document.fonts.ready.then(mirrorSoon); }

  function initField(wrapper) {
    if (!wrapper || wrapper.dataset.phoneFieldReady) return;
    var p = parts(wrapper);
    if (!p.select || !p.input) return;
    wrapper.dataset.phoneFieldReady = '1';

    Array.prototype.forEach.call(p.select.options, function (o) { o.setAttribute('data-full', o.textContent.trim()); });
    ['focus', 'mousedown', 'touchstart'].forEach(function (ev) { p.select.addEventListener(ev, function () { expandCodes(p.select); }, { passive: true }); });
    ['change', 'blur'].forEach(function (ev) { p.select.addEventListener(ev, function () { collapseCodes(p.select); }); });
    window.addEventListener('resize', function () { if (document.activeElement !== p.select) collapseCodes(p.select); });

    p.input.setAttribute('inputmode', 'numeric');
    p.input.setAttribute('autocomplete', 'tel-national');
    p.input.setAttribute('maxlength', maxLen(p.select));

    p.input.addEventListener('input', function () {
      touch(wrapper);
      var digits = p.input.value.replace(/\D/g, '').slice(0, maxLen(p.select));
      if (digits !== p.input.value) p.input.value = digits;
      syncHidden(wrapper);
      if (p.error && !p.error.hidden) showProblem(wrapper); // clear the message as soon as it is fixed
    });
    p.input.addEventListener('blur', function () { if (p.input.value) showProblem(wrapper); });
    p.select.addEventListener('change', function () {
      touch(wrapper);
      p.input.setAttribute('maxlength', maxLen(p.select));
      p.input.value = p.input.value.slice(0, maxLen(p.select));
      syncHidden(wrapper);
      if (p.input.value) showProblem(wrapper);
    });

    var initial = wrapper.getAttribute('data-initial');
    if (initial) {
      populate(wrapper, initial);
      // Show it, but do not rewrite or reject what was already saved until the customer changes it.
      wrapper.dataset.pristine = '1';
      if (p.hidden) p.hidden.value = initial;
    } else {
      syncHidden(wrapper);
    }
    collapseCodes(p.select);
    mirrorStyle(wrapper);
    // A field that is inside something shown later (a gate, a pop-up, a collapsed card) is measured again the first time it is touched or seen.
    ['focusin', 'pointerenter', 'touchstart'].forEach(function (ev) { wrapper.addEventListener(ev, function () { mirrorStyle(wrapper); }, { passive: true }); });
    if (window.IntersectionObserver) {
      var io = new IntersectionObserver(function (entries) { entries.forEach(function (en) { if (en.isIntersecting) { mirrorStyle(wrapper); io.disconnect(); } }); });
      io.observe(wrapper);
    }
  }

  document.querySelectorAll('[data-phone-field]').forEach(initField);

  window.InviteutsavPhone = { init: initField, isValid: isValid, sync: syncHidden, populate: populate, touch: touch };
})();
